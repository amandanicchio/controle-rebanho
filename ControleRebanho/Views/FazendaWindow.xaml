<Window x:Class="ControleRebanho.Views.FazendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minha fazenda" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Minha fazenda" Style="{StaticResource TituloTela}"/>

        <TextBlock Text="Nome da fazenda" Style="{StaticResource Rotulo}"/>
        <TextBox x:Name="CampoNome"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Código da propriedade" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="CampoCodigo"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="UF" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="CampoUf" MaxLength="2" CharacterCasing="Upper"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Município" Style="{StaticResource Rotulo}"/>
        <TextBox x:Name="CampoMunicipio"/>

        <TextBlock x:Name="TextoErro" Style="{StaticResource TextoErro}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True"/>
            <Button Content="Salvar" IsDefault="True" Click="Salvar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
