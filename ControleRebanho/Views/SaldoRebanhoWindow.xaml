<Window x:Class="ControleRebanho.Views.SaldoRebanhoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saldo do rebanho" Width="620" Height="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <StackPanel Width="150" Margin="0,0,12,0">
                <TextBlock Text="Data" Style="{StaticResource Rotulo}"/>
                <DatePicker x:Name="CampoData"/>
            </StackPanel>
            <Button Content="Ver saldo" VerticalAlignment="Center" IsDefault="True" Click="VerSaldo_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Imprimir" Click="Imprimir_Click"/>
            <Button Content="Voltar" IsCancel="True"/>
        </StackPanel>

        <StackPanel x:Name="AreaRelatorio" Background="White">
            <TextBlock x:Name="TextoTitulo" Text="Saldo do rebanho" Style="{StaticResource TituloTela}" Margin="0,8,0,8"/>
            <DataGrid x:Name="GradeSaldo">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Faixa" Binding="{Binding Faixa}" Width="140"/>
                    <DataGridTextColumn Header="Machos" Binding="{Binding Machos}" Width="*"/>
                    <DataGridTextColumn Header="Fêmeas" Binding="{Binding Femeas}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="TextoTotais" Margin="0,8,0,0"/>
            <TextBlock x:Name="TextoTotalGeral" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
