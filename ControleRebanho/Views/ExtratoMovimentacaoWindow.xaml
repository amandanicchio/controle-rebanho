<Window x:Class="ControleRebanho.Views.ExtratoMovimentacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extrato de movimentação" Width="760" Height="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <StackPanel Width="150" Margin="0,0,12,0">
                <TextBlock Text="De" Style="{StaticResource Rotulo}"/>
                <DatePicker x:Name="CampoDe"/>
            </StackPanel>
            <StackPanel Width="150" Margin="0,0,12,0">
                <TextBlock Text="Até" Style="{StaticResource Rotulo}"/>
                <DatePicker x:Name="CampoAte"/>
            </StackPanel>
            <Button Content="Filtrar" VerticalAlignment="Center" IsDefault="True" Click="Filtrar_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Imprimir" Click="Imprimir_Click"/>
            <Button Content="Voltar" IsCancel="True"/>
            <TextBlock Style="{StaticResource Rotulo}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="Saldo é a foto de um dia; o extrato mostra o que mudou no período."/>
        </StackPanel>

        <DockPanel x:Name="AreaRelatorio" Background="White">
            <TextBlock x:Name="TextoTitulo" DockPanel.Dock="Top" Text="Extrato de movimentação"
                       Style="{StaticResource TituloTela}" Margin="0,8,0,8"/>
            <TextBlock x:Name="TextoResumo" DockPanel.Dock="Bottom" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <DataGrid x:Name="GradeExtrato">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="100"/>
                    <DataGridTextColumn Header="Brinco" Binding="{Binding Brinco}" Width="100"/>
                    <DataGridTextColumn Header="Movimento" Binding="{Binding Movimento}" Width="110"/>
                    <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="120"/>
                    <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
