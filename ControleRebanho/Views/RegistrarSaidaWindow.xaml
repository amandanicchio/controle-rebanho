<Window x:Class="ControleRebanho.Views.RegistrarSaidaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar saída" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="TextoTitulo" Style="{StaticResource TituloTela}"/>
        <TextBlock x:Name="TextoResumo" Margin="0,0,0,12"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Motivo" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="ComboMotivo" SelectedIndex="0">
                    <ComboBoxItem Content="Venda" Tag="VENDA"/>
                    <ComboBoxItem Content="Morte" Tag="MORTE"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Data da saída" Style="{StaticResource Rotulo}"/>
                <DatePicker x:Name="CampoData"/>
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource Rotulo}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="O animal sai da lista de ativos, mas o histórico continua salvo."/>

        <TextBlock x:Name="TextoErro" Style="{StaticResource TextoErro}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True"/>
            <Button Content="Confirmar" Style="{StaticResource BotaoPerigo}" Click="Confirmar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
